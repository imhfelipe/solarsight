# SolarSight - Variáveis de Ambiente (Vercel Deployment)
# Aplicação 100% Stateless e Sem Necessidade de Chaves Pagas por Padrão

# URL Base da Aplicação (Opcional em Produção)
NEXT_PUBLIC_APP_URL=https://solarsight-faesa.vercel.app

# Chave opcional da Gemini API (Google AI Studio Tier Gratuito)
# Necessária apenas para a camada explicativa opcional em linguagem natural no Passo 4
GEMINI_API_KEY=

# APIs Públicas e Gratuitas Utilizadas:
# - NASA POWER API: https://power.larc.nasa.gov/api/temporal/climatology/point
# - Esri World Imagery (Leaflet Tile Provider): https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer
# - OpenStreetMap Nominatim: https://nominatim.openstreetmap.org/search
# - ViaCEP API: https://viacep.com.br/ws/
